 695   1          uint8_t low4 = 0;
 696   1          uint8_t checksum = 0;
 697   1          uint8_t i = 0;
 698   1      
 699   1          if(DataFrame_1 & 0x02) base_value += 3;
 700   1          else base_value += 0;
 701   1      
 702   1          base_value += ((DataFrame_1 & 0x7C) >> 2) - 16;
 703   1      
 704   1          base_value += 5;
 705   1      
 706   1          // if(AuxFrame[0] & 0xF0) base_value += 1;
 707   1          // else base_value += 0;
 708   1      
 709   1          // if(AuxFrame[0] & 0x0F) base_value += 1;
 710   1          // else base_value += 0;
 711   1          
 712   1          // 取低4位（即对16取模）
 713   1          low4 = base_value % 16;
 714   1          // 处理负数情况，确保结果为正数
 715   1          // if (low4 < 0) {
 716   1          //     low4 += 16;
 717   1          // }
 718   1          
 719   1          // 反序4位二进制
 720   1          checksum = 0;
 721   1          for (i = 0; i < 4; i++) {
 722   2              // 取出最低位并移到对应位置
 723   2              checksum |= ((low4 >> i) & 1) << (3 - i);
 724   2          }
 725   1          
 726   1          AuxFrame[3] &= 0xF0;
 727   1          AuxFrame[3] |= checksum;
 728   1      
 729   1      }
