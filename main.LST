 681          /**
 682           * 计算校验码：(mode - 1) + (temp - 16) + 5 取低4位后反序
 683           * 
 684           * 参数:
 685           *   mode: 模式值
 686           *   temp: 温度值
 687           * 
 688           * 返回:
 689           *   计算得到的校验码
 690           */
 691          void calculate_checksum() {
 692   1          // 计算基础值
 693   1          // uint8_t base_value = (mode - 1) + (temp - 16) + 5 + horizontal_swing + ventilate;
