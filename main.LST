 509          // 发送单个位（核心：对齐“载波+无载波”时序）
 510          // 逻辑0：560us载波（HS0038低） + 560us无载波（HS0038高）
 511          // 逻辑1：560us载波（HS0038低） + 1680us无载波（HS0038高）
 512          void IR_Send_Bit(bit v) {
 513   1          // 第一步：发送560us载波（HS0038输出低，对应原始数据的“低电平段”）
 514   1          TH0 = 0xFF;
 515   1          TL0 = 0xF0;    
 516   1          TH1 = 0xFD;
 517   1          TL1 = 0x15;
 518   1          TR0 = 1;
 519   1          TR1 = 1;
 520   1          IR = 0;
 521   1          // 560us ≈ 560/525 ≈ 1.06 tick → 用1个tick（550us，误差≈6%）
 522   1          TickFlag = 1;
 523   1          while(TickFlag);
 524   1          TR0 = 0;
 525   1          IR = 1;
 526   1          // 第二步：根据位值发送无载波时长（HS0038输出高，对应原始数据的“高电平段”）
 527   1          if (v) {
 528   2              // 逻辑1：1680us无载波 → 1680/550≈3.05 tick → 用3个tick（1650us，误差≈1.8%）
 529   2              TH1 = 0xF7;
 530   2              TL1 = 0x40;
 531   2              TR0 = 0;
 532   2              TR1 = 1;
 533   2              IR = 1;
 534   2              TickFlag = 1;
