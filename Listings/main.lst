 262          // 发送单个位（核心：对齐“载波+无载波”时序）
 263          // 逻辑0：560us载波（HS0038低） + 560us无载波（HS0038高）
 264          // 逻辑1：560us载波（HS0038低） + 1680us无载波（HS0038高）
 265          void IR_Send_Bit(bit v) {
 266   1          // 第一步：发送560us载波（HS0038输出低，对应原始数据的“低电平段”）
 267   1          TH1 = 0xFD;
 268   1          TL1 = 0x15;
 269   1          TR0 = 1;
 270   1          TR1 = 1;
 271   1          IR = 1;
 272   1          // 560us ≈ 560/525 ≈ 1.06 tick → 用1个tick（550us，误差≈6%）
 273   1          while(!TickFlag);
 274   1          TickFlag = 0;
 275   1          TR0 = 0;
 276   1          IR = 0;
 277   1          // 第二步：根据位值发送无载波时长（HS0038输出高，对应原始数据的“高电平段”）
 278   1          if (v) {
 279   2              // 逻辑1：1680us无载波 → 1680/550≈3.05 tick → 用3个tick（1650us，误差≈1.8%）
 280   2              TH1 = 0xF7;
 281   2              TL1 = 0x40;
 282   2              TR1 = 1;
 283   2              while(!TickFlag);
 284   2              TickFlag = 0;
 285   2          } else {
 286   2              // 逻辑0：560us无载波 → 560/550≈1.02 tick → 用1个tick（550us，误差≈2%）
 287   2              TH1 = 0xFD;
 288   2              TL1 = 0x15;
 289   2              TR1 = 1;
 290   2              while(!TickFlag);
 291   2              TickFlag = 0;
 292   2          }
 293   1          TR1 = 0;
 294   1          TR0 = 0;
 295   1          IR = 1;    
 296   1      }
